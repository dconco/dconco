VITE_API_BASE_URL=http://localhost:5000
VITE_UPTIMEROBOT_API_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Server-only (never exposed to the client). Get it from
# https://wakatime.com/settings/account -> "Secret API Key"
WAKATIME_API_KEY=

# Server-only. Public Play Games profile slug - the handle in your public
# profile url play.google.com/profile/<slug>. No API key or OAuth needed;
# level and achievements are scraped from the public page. Defaults to "dconco".
PLAY_GAMES_PROFILE=dconco