VITE_API_BASE_URL=http://localhost:5000
VITE_UPTIMEROBOT_API_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Server-only (never exposed to the client). Get it from
# https://wakatime.com/settings/account -> "Secret API Key"
WAKATIME_API_KEY=

# Server-only. Play Games OAuth2 creds for live player profile (level + XP).
# Create an OAuth client ID in Google Cloud (Credentials), then mint a refresh
# token via the OAuth Playground with scope
# https://www.googleapis.com/auth/games
# Playground url https://developers.google.com/oauthplayground
PLAY_GAMES_CLIENT_ID=
PLAY_GAMES_CLIENT_SECRET=
PLAY_GAMES_REFRESH_TOKEN=